{
  "name": "roadtrip-roulette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,relay -c cyan,magenta \"vite --port 3000\" \"tsx watch server/relay.ts\"",
    "client": "vite --port 3000",
    "relay": "tsx server/relay.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/relay.ts",
    "share": "npm run build && tsx scripts/share.ts",
    "relay:worker": "wrangler dev --config worker/wrangler.toml --port 8787",
    "deploy": "npm run build && wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.155.0"
  },
  "engines": {
    "node": ">=20"
  }
}
